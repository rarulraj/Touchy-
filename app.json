{
  "expo": {
    "name": "Touchy",
    "slug": "touchy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "touchy",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3EBDD",
    "ios": {
      "bundleIdentifier": "com.rarulraj.touchy",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Touchy listens when you tap the notch, so you can talk instead of type.",
        "NSSpeechRecognitionUsageDescription": "Touchy turns what you say into the next step on screen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EBDD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-widgets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Touchy listens when you tap the notch, so you can talk instead of type.",
          "speechRecognitionPermission": "Touchy turns what you say into the next step on screen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
