# Copy to .env. Do not commit .env.

# Optional. Without these, projects stay on the device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public origin for shared links, for example https://touchie.example.com
EXPO_PUBLIC_SHARE_BASE_URL=

# Server only. Used by the Expo API route at /api/ai. Never prefix this with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
